# See dunst(5) for all configuration options

[global]
  notification_limit = 10

  sort = update
  idle_threshold = 2m

  # Geometry
  width = (200, 400)
  height = (50, 200)
  origin = top-right
  offset = (5, 5)
  corner_radius = 10

  # Progress bar
  progress_bar = true
  progress_bar_height = 10
  progress_bar_frame_width = 1
  progress_bar_min_width = 150
  progress_bar_max_width = 300
  progress_bar_corner_radius = 10

  # Spacing / Frame (Border)
  gap_size = 5
  frame_width = 1
  frame_color = "#005f78"
  separator_height = 3
  separator_color = frame

  # Text
  font = Noto Sans
  markup = full
  format = "<b>%s</b><span size='90%'>\n%b</span>"
  alignment = left
  vertical_alignment = center

  # Icons
  enable_recursive_icon_lookup = true
  icon_theme = Papirus-Dark, Papirus, Adwaita
  icon_position = right
  min_icon_size = 48
  max_icon_size = 48

  # Misc/Advanced
  dmenu = /usr/bin/fuzzel --dmenu

  # mouse
  mouse_left_click = do_action, close_current
  mouse_middle_click = close_all
  mouse_right_click = close_current

  # https://en.m.wikibooks.org/wiki/Regular_Expressions/POSIX-Extended_Regular_Expressions
  enable_posix_regex = true


[experimental]
  pause_on_mouse_over = true

[urgency_low]
  background = "#053345b2"
  foreground = "#ecfeffb2"
  frame_color = "#005f78"
  highlight = "#005f78"
  timeout = 10

[urgency_normal]
  background = "#053345b2"
  foreground = "#ecfeff"
  frame_color = "#0092b8"
  highlight = "#0092b8"
  timeout = 10

[urgency_critical]
  background = "#460809b2"
  foreground = "#ecfeff"
  frame_color = "#ff6467"
  highlight = "#ff6467"
  timeout = 20


# Rules
[testing]
  appname = testing
  history_ignore = yes
  timeout = 60

[volume]
  stack_tag = volume_indicator
  history_ignore = true
  icon_position = top
  alignment = center
  format = "<span size='120%'><b>%s</b></span>"
  background = "#0000007f"
  foreground = "#ecfeff"
  frame_color = "#00000000"
  highlight = "#ecfeff"
  timeout = 3s

[battery]
  stack_tag = battery_state
  set_stack_tag = battery_state
  history_ignore = true
  format = "<span size='120%'><b>%s</b></span>"

[battery-critical]
  msg_urgency = critical
  stack_tag = battery_state

# vim: ft=ini
