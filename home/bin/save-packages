#!/usr/bin/bash

# Exit on errors
set -o errexit
set -o nounset
set -o pipefail

readonly program=${0##*/}
readonly pattern='^(intel-ucode|amd-ucode|vulkan-.+|xf86-.+|.*driver.*|zip|unzip|unrar-free)$' # use 7z (7zip) instead

function error() {
    >&2 echo "$program: error: $*"
    exit 1
}

function main() {
    local destination=${1:-$HOME/.dotfiles/etc}

    if ! command -v pacman > /dev/null; then
        error 'pacman is not available in this system'
    fi

    [[ -d $destination ]] || mkdir --parents "$destination"

    local file=$destination/packages.txt
    echo "$program: saving to '$file'"
    pacman --query --quiet --explicit --native | sed -E "/$pattern/d" > "$file"
}

main "$@"
