set default-list

# Pattern for packages to exclude from packages.txt.
# Exclude CPU microcode, drivers and redundant programs (7z is enough for most formats).
pkgs_filter := '^(intel-ucode|amd-ucode|vulkan-.+|xf86-.+|.*driver.*|zip|unzip|unrar-free)$'
pkgs_file := 'etc' / 'packages.txt'

# Order is important here, `install-system` must run after `install-packages`
# since it modifier `reflector.con` and could cause a package conflict.
[doc("Perform full system installation")]
install: create-dirs install-user install-packages install-system enable-services

[doc("Install system files")]
[group('PKGBUILD')]
[group('packages')]
install-system: clean gen-source
    sudo install -Dm644 etc/reflector.conf /etc/xdg/reflector/reflector.conf
    makepkg --syncdeps --install

[doc("Generate source.tar")]
[group('PKGBUILD')]
gen-source:
    tar --create --file source.tar LICENSE etc/ --directory home/dot-config/hypr/ wallpapers/
    updpkgsums

[doc("Lint PKGBUILD and generated files")]
[group('PKGBUILD')]
lint: gen-source
    makepkg --verifysource --force
    makepkg --cleanbuild --force
    namcap PKGBUILD *.tar.zst

[doc("Create standard user directories")]
create-dirs:
    mkdir --parents \
        ~/.cache \
        ~/.config \
        ~/.local/bin \
        ~/.local/share \
        ~/.local/state \
        ~/Documents \
        ~/Downloads \
        ~/Pictures/Screenshots \
        ~/Music \
        ~/Videos \
        ~/archives \
        ~/projects \
        ~/repos/pkgbuild

[doc("Install user and system packages")]
[script]
[group('packages')]
install-packages:
    set -euxo pipefail
    sudo pacman -S --needed - < etc/packages.txt
    for repo in 'ts_query_ls-bin' 'qogir-cursor-theme'; do
        dir="$HOME/repos/pkgbuild/$repo"
        [[ -d $dir ]] || git clone "https://aur.archlinux.org/$repo.git" "$dir"
        (cd "$dir" && makepkg --syncdeps --install --needed)
    done
    pipx install basedpyright pdfly
    ya pkg install

[doc("Updgrade user packages")]
[group('packages')]
upgrade-packages:
    pipx upgrade-all
    ya pkg upgrade

[doc(f"Save system packages to {{pkgs_file}}")]
[group('packages')]
@save-packages:
    pacman -Q --quiet --explicit --native | sed -E "/{{pkgs_filter}}/d" > '{{pkgs_file}}'
    git diff '{{pkgs_file}}'

[doc("Install user configuration files")]
[script]
install-user:
    set -euxo pipefail
    stow --verbose --dotfiles home
    tag='@generated by .dotfiles/justfile'
    if ! [ -e ~/.bashrc ] || ! grep --silent --fixed-strings "$tag" ~/.bashrc; then
        printf '\n# %s\nsource ~/.config/bash/bashrc.bash\n' "$tag" >> ~/.bashrc
    fi

[doc("Enable user and system units")]
enable-services:
    systemctl enable \
        NetworkManager.service \
        cpupower.service \
        greetd.service \
        paccache.timer \
        reflector.timer \
        systemd-boot-update.service
    systemctl --user enable \
        gcr-ssh-agent.socket \
        hypridle.service \
        hyprpaper.service \
        tldrcache.timer \
        waybar.service

[doc("Delete auto-generated files")]
[group('PKGBUILD')]
@clean:
    rm -rf pkg/ src/ *.tar *.tar.gz *.tar.zst *.log *.pkg
